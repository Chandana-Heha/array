#include <stdio.h>

int main()
{
    char arr[100];
    int n;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter characters:\n");
    for (int i = 0; i < n; i++)
        scanf(" %c", &arr[i]);

    for (int i = 0; i < n; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (arr[i] == arr[j])
            {
                printf("First repeated character = %c", arr[i]);
                return 0;
            }
        }
    }

    printf("No repeated character");

    return 0;
}
