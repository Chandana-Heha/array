#include <stdio.h>

int main()
{
    int a[5] = {10, 20, 30, 40, 40};
    int i, largest, second;

    largest = a[0];
    second = -1;

    for(i = 1; i < 5; i++)
    {
        if(a[i] > largest)
        {
            second = largest;
            largest = a[i];
        }
        else if(a[i] > second && a[i] != largest)
        {
            second = a[i];
        }
    }

    printf("Second largest element = %d", second);

    return 0;
}

