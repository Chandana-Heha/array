#include <stdio.h>

int main()
{
    int arr[100], n;
    int lastRepeated = 0;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    for (int i = 0; i < n; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (arr[i] == arr[j])
            {
                lastRepeated = arr[i];
                break;
            }
        }
    }

    printf("Last repeated value = %d", lastRepeated);

    return 0;
}
